# Copy to .env for local development. Never commit real secrets.
PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
# Optional: persistent database path. Render disk example: /var/data/hostelhub.db
DB_PATH=
# Comma-separated frontend origins; empty allows all origins (convenient locally).
CORS_ORIGIN=http://localhost:5173
